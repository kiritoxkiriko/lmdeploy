ARG VERSION=v0.7.0.post3
FROM openmmlab/lmdeploy:${VERSION}-cu12

#ENV PIP_INDEX_URL=https://mirrors.ustc.edu.cn/pypi/web/simple

# add qwenvl-utils
RUN pip install --no-cache-dir prometheus_fastapi_instrumentator qwen-vl-utils flash-attn timm autoawq

RUN apt-get update && apt-get install -y rsync && apt-get clean

ENV ENABLE_METRICS=1

ENV ENABLE_LOG_REQUESTS=1

COPY ./lmdeploy/serve/openai/api_server.py /tmp/lmdeploy/serve/openai/api_server.py
COPY ./lmdeploy/pytorch/configurations/mlminternvl.py /tmp/lmdeploy/pytorch/configurations/mlminternvl.py
COPY ./lmdeploy/pytorch/models/mlminternvl.py /tmp/lmdeploy/pytorch/models/mlminternvl.py
COPY ./lmdeploy/vl/model/mlminternvl.py /tmp/lmdeploy/vl/model/mlminternvl.py
COPY ./lmdeploy/model.py /tmp/lmdeploy/model.py
COPY ./lmdeploy/vl/model/builder.py /tmp/lmdeploy/vl/model/builder.py
COPY ./lmdeploy/archs.py /tmp/lmdeploy/archs.py


# add custom api_server.py to lmdeploy package dynamically by copying it to the package directory
RUN rsync -avP --remove-source-files  /tmp/lmdeploy  $(pip show lmdeploy | grep Location | awk '{print $2}')/

#RUN mv /tmp/lmdeploy/serve/openai/api_server.py $(pip show lmdeploy | grep Location | awk '{print $2}')/lmdeploy/serve/openai/api_server.py && \
    #mv /tmp/lmdeploy/pytorch/configurations/mlminternvl.py $(pip show lmdeploy | grep Location | awk '{print $2}')/lmdeploy/pytorch/configurations/mlminternvl.py && \
    #mv /tmp/lmdeploy/pytorch/models/mlminternvl.py $(pip show lmdeploy | grep Location | awk '{print $2}')/lmdeploy/pytorch/models/mlminternvl.py && \
    #mv /tmp/lmdeploy/vl/model/mlminternvl.py $(pip show lmdeploy | grep Location | awk '{print $2}')/lmdeploy/vl/model/mlminternvl.py